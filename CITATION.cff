  #   given-names: Peter G.
  #   affiliation: "University of California Irvine"
  #   orcid: "https://orcid.org/0000-0002-8244-2042"

  - name: "AAPM BESC FLASH Working Group"
    website: "https://www.aapm.org/"

contact:
